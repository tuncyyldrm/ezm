NEXT_PUBLIC_SITE_URL=https://ezmoto.com.tr
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secrets: never add the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# GA4 browser tracking ID and server-only Data API credentials.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_EMAIL=
GA_SERVICE_ACCOUNT_PRIVATE_KEY=
# Must match the production website hostname. Reports are filtered to this host.
GA_HOSTNAME=ezmoto.com.tr
# Enable only after confirming the GA4 property belongs to EZM OTO.
GA_REALTIME_ENABLED=false
# Enable only after confirming GA4 excludes admin traffic from live reports.
GA_REALTIME_PUBLIC_ONLY=false
# Generate a matching public/private pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Use the site's HTTPS origin, or a mailto: address controlled by the site owner.
VAPID_SUBJECT=https://ezmoto.com.tr/
